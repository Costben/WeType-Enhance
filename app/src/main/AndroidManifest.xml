<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        「千问 / 豆包 壳」的监听跑在微信输入法输入法进程（`:hld`）里，由 Xposed hook 托管，
        模块 App 不需要常驻服务、也不需要前台通知 —— 详见 AsrShellHost 的类注释。
        壳只跑明文 HTTP，不涉及证书。
    -->

    <!--
        本模块自带 RecognitionService，自己开麦克风采音再转给微信输入法识别引擎。
        AOSP 的 RecognitionService 只检查**调用方**（Eta）的 RECORD_AUDIO；我们自己
        采音还得另有一份自己的，缺了会在 AudioRecord 构造/start 时失败。
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <queries>
        <package android:name="com.tencent.wetype" />
        <package android:name="com.oplus.aiwriter" />

        <!--
            语音识别服务必须能「看见」调用方，否则整个链路会在最后一步断掉。

            AOSP `RecognitionService` 放行一次会话前会拿**调用方**的 AttributionSource 去查
            `RECORD_AUDIO` appop；AppOpsService 会先 `AppsFilter.filterAppAccess(caller, 本进程 uid)`
            验包名可见性，看不见就直接返回 MODE_ERRORED（日志 `io.github.mangi.eta not found
            from 10652`），于是 `checkPermissionAndStartDataDelivery` 失败，服务被回
            ERROR_INSUFFICIENT_PERMISSIONS —— 明明调用方权限齐全、我们自己的录音权限也齐全。

            本模块 targetSdk 37，默认受包可见性过滤，只有 `<queries>` 命中的包才可见。
            按「谁参与语音识别」来放行，而不是硬编码某一个调用方的包名：凡是声明了
            `android.speech.RecognitionService` 的应用（Eta 自己就带一个兜底实现）都算。
        -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".ModuleApplication"
        android:allowBackup="true"
        android:description="@string/xposeddescription"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
            设置镜像与「系统识别服务」写入的入口，一律走 `ACTION_BRIDGE` + 显式组件，不需要过滤器。
            发送方是宿主设置页或模块 App 自己（另一个 uid），所以仍然 exported；
            处理时按发送方包名核对，未受信任的来源直接丢弃。
        -->
        <receiver
            android:name=".ModuleBridgeReceiver"
            android:enabled="true"
            android:exported="true" />

        <!--
            「Shizuku 授权」入口。宿主进程（设置页）用显式组件拉起它，所以必须 exported；
            它自己不接受任何外部数据，只把授权请求发出去，暴露出去没有额外风险。

            excludeFromRecents + noHistory：它是个一次性的授权中转页，授权完就退，
            不该在最近任务里留一张卡片。
        -->
        <activity
            android:name=".ShizukuAuthActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar" />

        <!--
            Shizuku 客户端声明。Shizuku 只把 binder 递给**声明了这个 provider 的进程**；
            没有它 `Shizuku.getBinder()` 永远是 null，而 binder 是拿 shell 权限写
            `Settings.Secure` 的唯一入口。authority 必须与 applicationId 对齐。

            注意它只覆盖模块 App 进程：设置页跑在宿主进程里，拿不到这份 binder，
            所以「先 Shizuku 后 root」里的 Shizuku 那一步必须由模块 App 代跑。
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!--
            把微信输入法的识别能力以**标准 RecognitionService** 的形式暴露给系统，
            于是 Eta 的「识别服务 → 系统语音服务」就能直接路由到本模块。

            刻意**不声明** android:permission：AOSP 里根本不存在
            BIND_SPEECH_RECOGNITION_SERVICE 这个权限（`pm list permissions` 里只有
            MANAGE_SPEECH_RECOGNITION，且是 signature 级），RecognitionService.onBind
            也不做任何权限校验。Google 自家的 GoogleTTS / AiAi 识别服务同样只写
            exported="true"，不带任何 android:permission。

            Eta 侧按包名排除自己，第三方服务一律有资格；它把
            permission == "android.permission.BIND_SPEECH_RECOGNITION_SERVICE" 只当作
            **排序偏好**，而且「配置项命中」「系统应用」两条都排在它前面。所以不写这条
            既不会被过滤掉，也不会被显著降权。
        -->
        <service
            android:name=".wetype.voice.WeTypeRecognitionService"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>
</manifest>
